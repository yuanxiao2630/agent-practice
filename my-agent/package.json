{
  "name": "my-agent",
  "version": "1.0.0",
  "description": "一个跑在本地的小 agent：终端或网页输入问题，模型通过工具查看当前仓库",
  "main": "apps/server/server.ts",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch apps/server/server.ts",
    "dev:web": "vite apps/web",
    "build": "vite build apps/web",
    "start": "node apps/server/server.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "agent": "node apps/server/agent.ts",
    "cli": "node apps/server/cli.ts",
    "test": "node --test \"apps/server/**/*.test.ts\"",
    "test:amap-http": "node apps/server/mcp/mcp-streamable-http.ts",
    "test:amap-stdio": "node apps/server/mcp/mcp-stdio.ts",
    "test:amap": "node apps/server/mcp/test-mcp-amap.ts",
    "example": "node examples/*.ts",
    "example:http": "node examples/http-practice.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.10",
    "openai": "^7.55.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
