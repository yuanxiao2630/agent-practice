# 服务端环境变量示例
# 复制为 .env 后填写真实值；.env 不会被提交到 git。
# 这个文件与 apps/server/.env 的键一致，两个 server 各读自己目录下的 .env。

# ---- 服务 ----
PORT=3000
HOST=127.0.0.1
# 单次请求体上限（字节）
BODY_LIMIT=1000000

# ---- 模型 ----
MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# 一轮对话里最多允许几次工具往返
MAX_ROUNDS=10

# ---- 外部服务 ----
AMAP_WEB_KEY=
