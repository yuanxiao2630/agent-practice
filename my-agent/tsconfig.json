{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["apps/server/**/*.ts", "apps/server-express/**/*.ts", "examples/**/*.ts"],
  "exclude": ["node_modules", "apps/web", "apps/web/dist"]
}
